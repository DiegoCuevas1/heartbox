# Where Next.js forwards /api, /accounts and /admin during `npm run dev`
# and `npm start`. Read at build time.
BACKEND_URL=http://localhost:8000

# Cloudinary cloud name used to build image URLs (public, not a secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dcyk5quni

# Only set this if the browser must call the API on a different origin.
# Leave unset to use same-origin /api (recommended).
# NEXT_PUBLIC_API_URL=
