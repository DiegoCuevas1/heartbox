# Copy to .env for local development. In production set these in your host's
# secret manager instead of committing a file.

# "production" turns on secure cookies and requires SECRET_KEY.
DJANGO_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# DEBUG defaults to true in development and false in production.
# DEBUG=false

DATABASE_URL=postgres://postgres:postgres@localhost:5432/heartbox

# Comma-separated. Include the internal hostname the proxy uses (e.g. "backend").
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Public URL of the web app (used in password reset emails and login redirects).
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload caps in bytes (defaults: 10MB images, 50MB videos).
# MAX_IMAGE_UPLOAD_BYTES=10485760
# MAX_VIDEO_UPLOAD_BYTES=52428800

# Password reset email. Development prints emails to the console.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=HeartBox <no-reply@yourdomain.com>

# Social login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
