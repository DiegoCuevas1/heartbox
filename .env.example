# Settings for the production stack in docker-compose.yml.
# Copy to .env on the server and fill in. Never commit the real .env.

# Public domain, pointed at this server with a DNS A record.
DOMAIN=heartbox.example.com

# Long random strings, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=
POSTGRES_PASSWORD=

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset email (any SMTP provider: Resend, Amazon SES, Postmark, ...)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HeartBox <no-reply@heartbox.example.com>

# Throttling behind Caddy: trust one proxy hop for client IPs.
NUM_PROXIES=1

# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
